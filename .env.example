# Copy to .env.local. Every variable is explained in README.md.

# ---- provider ----
PROVIDER=payload

# ---- payload: required ---- (secrets: 32+ chars)
DATABASE_URL=postgres://user:password@host:5432/database
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- payload: required on Vercel ----
BLOB_READ_WRITE_TOKEN=

# ---- payload: optional ----
PREVIEW_SECRET=

# ---- api: required ----
API_URL=https://cms.exemplo.pt/api

# ---- api: optional ----
API_TOKEN=
API_REVALIDATE=60

# ---- mock: nothing to configure ----
