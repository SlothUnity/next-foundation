{
  "name": "next-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm lint && pnpm typecheck && next dev",
    "dev:payload": "pnpm run payload:generate && pnpm run dev",
    "build": "pnpm lint && pnpm typecheck && pnpm test --run && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest",
    "generate": "cross-env NODE_OPTIONS=\"--import tsx\" plop --plopfile=generator/plopfile.ts",
    "payload:types": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts payload generate:types",
    "payload:importMap": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts payload generate:importmap",
    "payload:generate": "pnpm run payload:types && pnpm run payload:importMap"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/live-preview-react": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/plugin-nested-docs": "^3.88.0",
    "@payloadcms/plugin-seo": "^3.88.0",
    "@payloadcms/ui": "3.88.0",
    "next": "16.3.0",
    "payload": "^3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "plop": "^4.0.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.7.1"
}
